{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (GCC)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/proj", // Path to the output file
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "miDebuggerPath": "/usr/bin/gdb", // Change this if gdb is in a different location
      "preLaunchTask": "build", // Specify the task to build the project before launching
      "logging": {
        "moduleLoad": false,
        "trace": true,
        "traceResponse": true,
        "engineLogging": false
      },
      "compilationDatabasePath": "",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "pattern": "\\bWaiting for debugger\\b"
      }
    }
  ]
}
